{
  "name": "@hellboy/bridge",
  "version": "1.1.0",
  "private": true,
  "description": "MCP server that bridges a terminal agent to Ableton Live.",
  "license": "MIT",
  "main": "dist/src/index.js",
  "bin": {
    "hellboy-bridge": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=build/bridge.cjs",
    "pkg:mac-arm": "pkg build/bridge.cjs --targets node20-macos-arm64 --output dist/hellboy-bridge-darwin-arm64",
    "pkg:mac-x64": "pkg build/bridge.cjs --targets node20-macos-x64 --output dist/hellboy-bridge-darwin-x64",
    "pkg:win": "pkg build/bridge.cjs --targets node20-win-x64 --output dist/hellboy-bridge-win-x64.exe"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.4.1",
    "zod": "^3.23.8"
  }
}

#!/bin/bash
# ==============================================================================
# AbletonAgent.app wrapper — Launches interactive terminal in macOS Terminal.app
# ==============================================================================
DIR="$(cd "$(dirname "$0")/../../.." && pwd)"
PARENT="$(cd "$DIR/.." && pwd)"

# Launch interactive CLI inside a fresh Terminal.app window
osascript <<EOF
tell application "Terminal"
    activate
    if exists (window 1) and not busy of window 1 then
        do script "export PYTHONPATH='$PARENT/src:\$PYTHONPATH' && python3 -m ableton_agent.cli" in window 1
    else
        do script "export PYTHONPATH='$PARENT/src:\$PYTHONPATH' && python3 -m ableton_agent.cli"
    end if
end tell
EOF
